# Copy this file to .env and set the values.

# --- Database
DB_PASSWORD=change-this-password

# --- Authentication
# Initial administrator: created on first start, when no user exists yet.
# After that, users and passwords are managed from the dashboard and these values are no longer read.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: shared token of the installations that predate personal hook keys.
# If set, it is imported as a hook key of the initial administrator, which can be revoked from the dashboard.
HOOK_TOKEN=
# Secret used to sign the JWTs, at least 32 characters. Generate it with: openssl rand -hex 32
JWT_SECRET=
# Login duration
JWT_TTL=30d

# --- Sessions
# After this long without events the session becomes STALE
STALE_AFTER=30m

# --- Web Push (generate the keys with scripts/generate-vapid-keys.sh)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact required by the protocol: mailto: or https URL
VAPID_SUBJECT=mailto:admin@example.com

# --- PrimeUI license (required by PrimeNG 22, also for the free Community License)
# Get it from https://primeui.dev/licenses. It is embedded in the frontend bundle at build time;
# without a key the dashboard works but shows a notice in the bottom right corner.
PRIMENG_LICENSE=

# --- Cloudflare tunnel for local testing ("tunnel" profile)
# Tunnel token, from the Cloudflare Zero Trust dashboard or with: cloudflared tunnel token <name>
CLAUDE_MONITOR_TUNNEL_TOKEN=

# --- Host ports
FRONTEND_PORT=8088
BACKEND_PORT=8080
