# Copia questo file in .env e imposta i valori.

# --- Database
DB_PASSWORD=cambia-questa-password

# --- Autenticazione
# Amministratore iniziale: creato al primo avvio, quando non esiste ancora nessun utente.
# Dopo, utenti e password si gestiscono dalla dashboard e questi valori non vengono più letti.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Facoltativo: token condiviso delle installazioni precedenti alle chiavi hook personali.
# Se presente viene importato come chiave hook dell'amministratore iniziale, revocabile dalla dashboard.
HOOK_TOKEN=
# Segreto per firmare i JWT, almeno 32 caratteri. Genera con: openssl rand -hex 32
JWT_SECRET=
# Durata del login
JWT_TTL=30d

# --- Sessioni
# Senza eventi per questo tempo la sessione diventa STALE
STALE_AFTER=30m

# --- Web Push (genera le chiavi con scripts/generate-vapid-keys.sh)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contatto richiesto dal protocollo: mailto: o URL https
VAPID_SUBJECT=mailto:admin@example.com

# --- Licenza PrimeUI (PrimeNG 22 la richiede, anche per la Community License gratuita)
# Si ottiene da https://primeui.dev/licenses. Viene inserita nel bundle del frontend in fase di build;
# senza chiave la dashboard funziona ma mostra un avviso in basso a destra.
PRIMENG_LICENSE=

# --- Tunnel Cloudflare per i test locali (profilo "tunnel")
# Token del tunnel, dalla dashboard Cloudflare Zero Trust oppure con: cloudflared tunnel token <nome>
CLAUDE_MONITOR_TUNNEL_TOKEN=

# --- Porte sull'host
FRONTEND_PORT=8088
BACKEND_PORT=8080
